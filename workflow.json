    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rawDescription = $json.description || \"\";\n\nconst cleanDescription = rawDescription\n  .replace(/<script\\b[^>]*>[\\s\\S]*?<\\/script>/gi, \" \")\n  .replace(/<style\\b[^>]*>[\\s\\S]*?<\\/style>/gi, \" \")\n  .replace(/<[^>]*>/g, \" \")\n  .replace(/&nbsp;/gi, \" \")\n  .replace(/&amp;/gi, \"&\")\n  .replace(/&lt;/gi, \"<\")\n  .replace(/&gt;/gi, \">\")\n  .replace(/&quot;/gi, '\"')\n  .replace(/&#39;|&apos;/gi, \"'\")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\nreturn {\n  ...$json,\n  description_clean: cleanDescription,\n  description_clean_length: cleanDescription.length,\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "id": "42993fdb-76b5-4f10-a53f-b432d9e69a37",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst rawDescription = $json.description_clean || $json.description || \"\";\n\nconst description = rawDescription\n  .replace(/<[^>]*>/g, \" \")\n  .replace(/&nbsp;/gi, \" \")\n  .replace(/&amp;/gi, \"&\")\n  .replace(/\\s+/g, \" \")\n  .toLowerCase();\n\nconst title = ( $json.title|| \"\").toLowerCase();\n\nconst candidate = {\n  professionalSkills: [\n    \"business analysis\", \"requirements gathering\",\n    \"requirements analysis\", \"functional specifications\",\n    \"brd\", \"frd\", \"fsd\", \"use cases\", \"user stories\",\n    \"acceptance criteria\", \"uat coordination\",\n    \"stakeholder management\", \"scope management\",\n    \"sql\", \"etl\", \"rest api integration\",\n    \"database-integrated automation\", \"python\",\n    \"powershell\", \"power bi\", \"excel\", \"tableau\",\n    \"zoho analytics\", \"servicenow\", \"ansible\", \"mfoo\",\n    \"power automate\", \"process discovery\",\n    \"value stream mapping\", \"gap analysis\",\n    \"process mapping\", \"bpmn\", \"agile\", \"scrum\",\n    \"jira\", \"confluence\", \"azure devops\",\n    \"kpi tracking\", \"root-cause analysis\",\n    \"solution design\", \"ci/cd\", \"time-series analysis\",\n    \"trend analysis\"\n  ],\n\n  projectSkills: [\n    \"pandas\", \"numpy\", \"scikit-learn\",\n    \"llm-based text classification\", \"semantic clustering\",\n    \"predictive modelling\", \"demand forecasting\",\n    \"no-show prediction\", \"multi-agent systems\",\n    \"llm-based reasoning\", \"automation probability scoring\",\n    \"amazon bedrock\", \"nova models\",\n    \"interpretive structural modelling\", \"micmac analysis\"\n  ],\n\n  platformsAndCloud: [\n    \"azure\", \"aws\", \"aws s3\", \"aws lambda\", \"aws ec2\",\n    \"shopify\", \"businessonbot\", \"visio\"\n  ]\n};\n\nfunction findMatches(skills) {\n  return skills.filter(skill => description.includes(skill));\n}\n\nconst professionalMatches = findMatches(candidate.professionalSkills);\nconst projectMatches = findMatches(candidate.projectSkills);\nconst platformMatches = findMatches(candidate.platformsAndCloud);\n\nconst professionalCoverage =\n  professionalMatches.length / candidate.professionalSkills.length;\n\nconst projectCoverage =\n  projectMatches.length / candidate.projectSkills.length;\n\nconst platformCoverage =\n  platformMatches.length / candidate.platformsAndCloud.length;\n\n\nconst matchScore = Math.round(\n  70 * professionalCoverage +\n  20 * projectCoverage +\n  10 * platformCoverage\n);\n\nreturn {\n  ...$json,\n  match_score: Math.min(100, matchScore),\n  matched_professional_skills: professionalMatches,\n  matched_project_skills: projectMatches,\n  matched_platforms: platformMatches,\n  scoring_method: \"Resume-profile keyword coverage (initial estimate)\"\n};\n"
      },
